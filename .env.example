# Copy to .env. Read by `npm start` (node --env-file-if-exists) AND by Docker
# Compose. Compose only uses it for ${...} substitution inside compose.yaml, so
# host-only settings such as HOST and PORT never leak into the container.
#
# Run `npm run doctor` after editing. It resolves this file the way the server
# does and names the exact reason a connection would fail.

# ---------------------------------------------------------------------------
# Always set
# ---------------------------------------------------------------------------

# The shared secret for EveJS's /_evejs-web/v1 gateway. Put the SAME value in
# eve.js/.env.
#
# ⚠ REQUIRED the moment either side runs in a container. The gateway grants
# token-less access only to peers whose socket address is 127.0.0.1 or ::1
# (eve.js server/src/_secondary/express/evejsWebGateway.js). Anything crossing a
# container boundary arrives from a Docker bridge address and is refused.
#
# Safe to set even for a host-only setup: EveJS falls back to the loopback rule
# whenever ITS OWN EVEJS_WEB_GATEWAY_TOKEN is unset, so an extra token on this
# side is simply ignored. Setting it unconditionally is the recommendation —
# then every combination below works without further edits.
#
# Generate one:
#   powershell -Command "[Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))"
EVEJS_WEB_GATEWAY_TOKEN=

# Where the EveJS checkout lives. Used for static names (type/station/system)
# and, when the BFF runs in Docker, as the read-only bind mount source.
EVEJS_ROOT=C:\Users\ryanf\Documents\GitHub\eve.js

# ---------------------------------------------------------------------------
# BFF on the HOST (`npm start`)
# ---------------------------------------------------------------------------
# Ignored entirely when the BFF runs in Docker; the image sets its own.

PORT=26500
HOST=127.0.0.1

# EveJS on the host  -> leave unset; the default below is already correct.
# EveJS in Docker    -> also leave unset. eve.js/compose.yaml publishes 26002 on
#                       127.0.0.1, so the address does not change — but the
#                       token above becomes mandatory, because Docker's port
#                       forwarder rewrites the peer address off loopback.
# EVEJS_GATEWAY_URL=http://127.0.0.1:26002/_evejs-web/v1

# ---------------------------------------------------------------------------
# BFF in DOCKER (`docker compose up`)
# ---------------------------------------------------------------------------
# The gateway URL and the static-data paths are set by the compose files, not
# here — compose.yaml for a native EveJS, compose.evejs-docker.yaml for an
# EveJS in Docker. The only knob is the published host port.

# EVEJS_WEB_POC_PORT=26500

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------

# Static gameStore tables and SDE JSONL. Default to the native layout under
# EVEJS_ROOT/_local. Only worth setting by hand if your gameStore is somewhere
# unusual; the compose files already set both for containerised runs.
# EVEJS_GAMESTORE_DATA_DIR=
# EVEJS_SDE_DIR=

# Used only by the manual icon-cache scraper, never for gameplay runtime access.
# EVEJS_GAMESTORE_DB=C:\Users\ryanf\Documents\GitHub\eve.js\_local\gameStore\gamestore.sqlite
