{
  "name": "evejs-web-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal browser companion POC for EveJS.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:web": "vite",
    "build:web": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test",
    "webpass": "node scripts/set-web-password.js",
    "cache-icons": "node scripts/cache-icons.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "express": "^5.1.0",
    "ws": "^8.21.1"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
